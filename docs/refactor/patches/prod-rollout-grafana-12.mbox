From aea563da503866d74ad9065a011d62c0c765a607 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 23 Sep 2026 09:24:57 +0000
Subject: [PATCH 5/7] Disable setuptools package discovery so the CI install
 step works

`pip install -e .[dev]`, the CI's install step, aborts with "Multiple
top-level packages discovered in a flat-layout" on lib/, deploy/, grafana/
and friends. This predates the quick fixes: the branch fails the same way
without them. The CI only triggers on pushes to main/master and on pull
requests, which is likely why it never surfaced here.

The repo is a set of scripts, not an importable package, so declaring no
modules is the accurate fix. The install then only pulls the dependencies.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016getrRJmgohzHoA5TH2zVQ
---
 pyproject.toml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/pyproject.toml b/pyproject.toml
index 44c2d99..c266b90 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -14,6 +14,12 @@ dev = [
     "ruff>=0.6",
 ]
 
+# This repo is a collection of scripts, not an importable package. Without
+# this, setuptools' flat-layout discovery aborts `pip install -e .[dev]` on the
+# lib/, deploy/, grafana/... directories, and the CI install step fails.
+[tool.setuptools]
+py-modules = []
+
 [tool.pytest.ini_options]
 testpaths = ["tests"]
 python_files = ["test_*.py"]
