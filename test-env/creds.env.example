# UTM credentials for the test environment.
# Telegraf in the lab container loads this file via env_file directive.
# With these placeholder values the script will FAIL to reach UCS — that
# is the expected validation signal that the env-var pipeline works.

UTM_DOMAINS=lab1
UTM_lab1_HOST=10.0.0.99
UTM_lab1_USER=monitoring
UTM_lab1_PASS=replace-me
UTM_lab1_GROUP=lab
